<?xml version="1.1" encoding="UTF-8" standalone="no"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog-ext https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd
                        http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.4.xsd">

    <changeSet id="76-highlight-endpoint" author="david">
        <createTable tableName="highlight">
            <column name="highlight_id" type="bigint">
                <constraints primaryKey="true" nullable="false" primaryKeyName="highlight_id_pk" />
            </column>
            <column name="alt_text" type="varchar(255)" />
            <column name="description" type="varchar(255)" />
            <column name="path" type="varchar(255)" />
        </createTable>

        <createSequence sequenceName="highlight_id_seq"
            dataType="bigint"
            incrementBy="1"
            startValue="100" />
    </changeSet>
</databaseChangeLog>
