<?xml version="1.1" encoding="UTF-8" standalone="no"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog-ext
    https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd
    http://www.liquibase.org/xml/ns/dbchangelog
    https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.4.xsd">

    <changeSet id="81-create-countdown-table" author="dominik">
        <createTable tableName="countdown">
            <column name="countdown_id" type="bigint" defaultValue="100">
                <constraints primaryKey="true" nullable="false" primaryKeyName="countdown_id_pk"/>
            </column>
            <column name="end_date_time_in_utc" type="bigint"/>
        </createTable>
    </changeSet>
</databaseChangeLog>
